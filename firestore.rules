rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User profile validation
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'name']) &&
             data.uid is string &&
             data.uid == request.auth.uid &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100;
    }

    // Transaction validation
    function isValidTransaction(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'type', 'amount', 'title', 'categoryId', 'accountId', 'date']) &&
             data.id is string && isValidId(data.id) &&
             data.userId == userId &&
             data.userId == request.auth.uid &&
             data.type in ['expense', 'income', 'transfer'] &&
             data.amount is number && data.amount >= 0 &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.categoryId is string &&
             data.accountId is string &&
             data.date is string && data.date.size() <= 30;
    }

    // Budget validation
    function isValidBudget(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'categoryId', 'limit', 'month']) &&
             data.id is string && isValidId(data.id) &&
             data.userId == userId &&
             data.userId == request.auth.uid &&
             data.categoryId is string &&
             data.limit is number && data.limit >= 0 &&
             data.month is string && data.month.size() <= 20;
    }

    // Goal validation
    function isValidGoal(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'name', 'targetAmount', 'currentAmount']) &&
             data.id is string && isValidId(data.id) &&
             data.userId == userId &&
             data.userId == request.auth.uid &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.targetAmount is number && data.targetAmount >= 0 &&
             data.currentAmount is number && data.currentAmount >= 0;
    }

    // Bank Account validation
    function isValidBank(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'bankName', 'bankCode', 'accountNumber', 'accountHolder', 'balance']) &&
             data.id is string && isValidId(data.id) &&
             data.userId == userId &&
             data.userId == request.auth.uid &&
             data.bankName is string && data.bankName.size() > 0 && data.bankName.size() <= 100 &&
             data.accountNumber is string && data.accountNumber.size() <= 50 &&
             data.balance is number;
    }

    // Match users collection
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId) && isValidUser(request.resource.data);
      allow delete: if isOwner(userId);

      // Subcollection: Transactions
      match /transactions/{transactionId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidTransaction(request.resource.data, userId);
        allow update: if isOwner(userId) && isValidTransaction(request.resource.data, userId);
        allow delete: if isOwner(userId);
      }

      // Subcollection: Budgets
      match /budgets/{budgetId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidBudget(request.resource.data, userId);
        allow update: if isOwner(userId) && isValidBudget(request.resource.data, userId);
        allow delete: if isOwner(userId);
      }

      // Subcollection: Goals
      match /goals/{goalId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidGoal(request.resource.data, userId);
        allow update: if isOwner(userId) && isValidGoal(request.resource.data, userId);
        allow delete: if isOwner(userId);
      }

      // Subcollection: Banks
      match /banks/{bankId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidBank(request.resource.data, userId);
        allow update: if isOwner(userId) && isValidBank(request.resource.data, userId);
        allow delete: if isOwner(userId);
      }
    }
  }
}
